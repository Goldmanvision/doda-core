// DoDA input bindings.

addkeysection "DoDA Controls" DoDAControls


// Core interactions.

addmenukey "Use" +use
defaultbind f +use

addmenukey "Left Lean" +user1
defaultbind q +user1

addmenukey "Right Lean" +user2
defaultbind e +user2

addmenukey "Reload Weapon" +reload
defaultbind r +reload


// Deadzone Aim Mode.

addmenukey "DoDA Aim Mode" +doda_aimmode
alias +doda_aimmode "DoDA_SetDeadzone 1"
alias -doda_aimmode "DoDA_SetDeadzone 0"
defaultbind mouse2 +doda_aimmode


// Left-hand and right-hand weapon selectors.

addmenukey "Equip Left Hand Weapon" +doda_equip_left
alias +doda_equip_left "+user5"
alias -doda_equip_left "-user5"
defaultbind z +doda_equip_left

addmenukey "Equip Right Hand Weapon" +doda_equip_right
alias +doda_equip_right "+user6"
alias -doda_equip_right "-user6"
defaultbind x +doda_equip_right


// Hand-based fire mode controls.

addmenukey "Cycle Left-Hand Fire Mode" +doda_cycle_firemode_left
alias +doda_cycle_firemode_left "+user3"
alias -doda_cycle_firemode_left "-user3"
defaultbind c +doda_cycle_firemode_left

addmenukey "Cycle Right-Hand Fire Mode" doda_cycle_firemode_right
alias doda_cycle_firemode_right "netevent DoDA_CycleRightFireMode"
defaultbind b doda_cycle_firemode_right


// Weapon Secondary Action / Hand Swapping.

addmenukey "Weapon Secondary Action / Swap Hands" +doda_weaponsecondary
alias +doda_weaponsecondary "doda_weapon_secondary 1"
alias -doda_weaponsecondary "doda_weapon_secondary 0"
defaultbind v +doda_weaponsecondary

alias +doda_swap_hands "+doda_weaponsecondary"
alias -doda_swap_hands "-doda_weaponsecondary"


// Legacy weapon secondary & hand swap aliases.

addmenukey "Swap Beretta" +doda_swapberetta
alias +doda_swapberetta "doda_swap_beretta 1"
alias -doda_swapberetta "doda_swap_beretta 0"

addmenukey "Manual Weapon Action / Fire Mode" +doda_firemode
alias +doda_firemode "+user3"
alias -doda_firemode "-user3"

addmenukey "Toggle Pistol Swap Lock" +doda_toggle_pistol_swap_lock
alias +doda_toggle_pistol_swap_lock "doda_toggle_pistol_swap_lock 1"
alias -doda_toggle_pistol_swap_lock "doda_toggle_pistol_swap_lock 0"


// Akimbo and Dual Wield controls.

addmenukey "Toggle Akimbo" doda_toggle_akimbo
alias doda_toggle_akimbo "netevent DoDA_ToggleAkimbo"
defaultbind n doda_toggle_akimbo

addmenukey "Toggle Dual Wield" doda_toggle_dual_wield
alias doda_toggle_dual_wield "netevent DoDA_ToggleDualWield"


// Weapon-slot defaults.

addmenukey "Select B92 Pistols" doda_select_b92
alias doda_select_b92 "slot 2"
defaultbind 2 doda_select_b92

addmenukey "Select Shotgun" doda_select_shotgun
alias doda_select_shotgun "slot 3"
defaultbind 3 doda_select_shotgun

addmenukey "Select MP5KSD" doda_select_mp5
alias doda_select_mp5 "slot 4"
defaultbind 4 doda_select_mp5

addmenukey "Holster" DoDA_Holster
alias DoDA_Holster "use DoDAHolster"
defaultbind 1 DoDA_Holster